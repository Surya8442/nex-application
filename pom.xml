<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent -->
    <parent>
        <groupId>org.sonatype.oss</groupId>
        <artifactId>oss-parent</artifactId>
        <version>7</version>
    </parent>

    <!-- Project Info -->
    <groupId>com.github.ffpojo</groupId>
    <artifactId>ffpojo-parent</artifactId>
    <version>2.0.REPACKAGE</version>
    <packaging>pom</packaging>

    <name>FFPOJO Project</name>
    <description>Flat-File Parser library for Java applications</description>
    <url>https://github.com/ffpojo</url>

    <!-- License -->
    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <!-- SCM -->
    <scm>
        <connection>scm:git:git@github.com:ffpojo/ffpojo.git</connection>
        <developerConnection>scm:git:git@github.com:ffpojo/ffpojo.git</developerConnection>
        <url>https://github.com/ffpojo/ffpojo</url>
    </scm>

    <!-- Developers -->
    <developers>
        <developer>
            <id>gibaholms</id>
            <name>Gilberto Augusto Holms</name>
            <email>gibaholms85@gmail.com</email>
        </developer>

        <developer>
            <id>blackstile</id>
            <name>William Miranda de Jesus</name>
            <email>blackstile@hotmail.com</email>
        </developer>
    </developers>

    <!-- Dependencies -->
    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Modules -->
    <modules>
        <module>ffpojo</module>
        <module>ffpojo-samples</module>
    </modules>

    <!-- Properties -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <!-- Build -->
    <build>
        <pluginManagement>
            <plugins>

                <!-- Compiler Plugin -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                    </configuration>
                </plugin>

                <!-- Source Plugin -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>

                <!-- Javadoc Plugin -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

    <!-- Nexus Deployment -->
    <distributionManagement>

        <repository>
            <id>maven-releases</id>
            <name>Nexus Releases</name>
            <url>http://13.201.97.32:8081/repository/maven-releases/</url>
        </repository>

        <snapshotRepository>
            <id>maven-snapshots</id>
            <name>Nexus Snapshots</name>
            <url>http://13.201.97.32:8081/repository/maven-snapshots/</url>
        </snapshotRepository>

    </distributionManagement>

</project>
